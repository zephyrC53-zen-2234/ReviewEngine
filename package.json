{
  "name": "reviewengine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:local": "node scripts/verify-local.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:start": "node --import tsx scripts/database.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx scripts/smoke-test.ts",
    "db:cleanup": "node --import tsx scripts/cleanup-limits.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "next-auth": "^4.24.11",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.16.0",
    "bcryptjs": "^3.0.2",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.0.0",
    "dotenv": "^17.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "prisma": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
